# Copy into your local ~/.ssh/config (Windows: %USERPROFILE%\.ssh\config)
# Works automatically with terminal SSH and VS Code Remote-SSH.

Host my-gpu-server
    HostName <YOUR_SERVER_IP_OR_DOMAIN>
    User <YOUR_REMOTE_USERNAME>

    # 1. Helper API channel (private Unix Domain Socket inside chmod 700 dir + Bearer Token)
    #    If your server sshd rejects Unix socket forwarding, use TCP loopback instead:
    #    RemoteForward 127.0.0.1:18765 127.0.0.1:18765
    RemoteForward /home/<YOUR_REMOTE_USERNAME>/.local/run/paper-bridge/helper.sock 127.0.0.1:18765

    # 2. Private read-only Zotero Local API channel for remote `zotero-mcp-paper-bridge`
    #    Targets the local read-only proxy on 23120 (blocks POST/PUT/DELETE and /connector/*)
    #    Avoids port 23119 collisions on multi-user Linux servers.
    RemoteForward /home/<YOUR_REMOTE_USERNAME>/.local/run/paper-bridge/zotero-read.sock 127.0.0.1:23120

    ServerAliveInterval 30
    ServerAliveCountMax 3
    ExitOnForwardFailure no
